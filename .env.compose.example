OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional: Tavily remote MCP web search for PersonalAgent API
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp
# Example: {"include_images":false,"search_depth":"basic","max_results":5}
TAVILY_DEFAULT_PARAMETERS=
ENABLE_WEB_SEARCH=true

# Required for PersonalAgent.Web startup (GitHub OAuth)
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret
GITHUB_ALLOWED_USERS=
GITHUB_CALLBACK_PATH=/signin-github

# Required for Work Journal Sync (PersonalAgent.Worker)
GITHUB_PAT=replace-with-your-github-pat
GITHUB_OWNER=replace-with-github-username
GITHUB_REPO=replace-with-journal-repo-name
GITHUB_BRANCH=main
GITHUB_JOURNAL_PATH=journal

# Optional. Defaults to dev-internal-api-key in compose.
# Set this to a strong value for non-local environments.
INTERNAL_API_KEY=dev-internal-api-key

# Optional: override agent storage DB separately from transport DB.
# Leave empty to use the same Postgres connection as transport.
AGENT_MEMORY_CONNECTION_STRING=

# Push notifications (Firebase Cloud Messaging)
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=personalagent-492423
ANDROID_PUSH_CHANNEL_ID=agent-approval-high
# Local file mounted into API container as /run/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# Alternative for hosted env vars (Railway, etc): base64-encoded service account JSON
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

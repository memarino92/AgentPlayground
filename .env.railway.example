# Copy this file to .env.railway and fill in the values before running scripts/setup-railway.ps1.

RAILWAY_API_TOKEN=
# Optional if already present in user secrets
OPENAI_API_KEY=
# Optional if already present in PersonalAgent.Web user secrets
GITHUB_CLIENT_ID=
# Optional if already present in PersonalAgent.Web user secrets
GITHUB_CLIENT_SECRET=
# Optional if already present in PersonalAgent.Web user secrets
GITHUB_ALLOWED_USERS=
# Optional if already present in PersonalAgent user secrets
INTERNAL_API_KEY=

# Optional
# Optional if already present in PersonalAgent.Web user secrets
GITHUB_CALLBACK_PATH=/signin-github
RAILWAY_PROJECT_NAME=AgentPlayground
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_NAME=production
RAILWAY_REPO_SLUG=your-org/your-repo
RAILWAY_REPO_BRANCH=main
RAILWAY_WORKSPACE_ID=
RAILWAY_DATABASE_SERVICE_NAME=Postgres

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="clr-namespace:PersonalAgent.Mobile.Services"
             x:Class="PersonalAgent.Mobile.MainPage" Title="Chat" SafeAreaEdges="All">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="WorkspaceAction" Text="Menu" Clicked="OnMenuClicked" />
        <ToolbarItem Text="Approvals" Clicked="OnOpenApprovalClicked" />
        <ToolbarItem x:Name="SettingsAction" Text="Settings" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>
    <Grid Padding="16,8" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <Label x:Name="ChatStatus" FontSize="14" MaxLines="4" LineBreakMode="HeadTruncation" />
            <Button x:Name="StopReply" Grid.Column="1" Text="Stop" IsVisible="False" Clicked="OnStopClicked" />
        </Grid>
        <CollectionView x:Name="Transcript" Grid.Row="1" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="chat:NativeChatMessage">
                    <VerticalStackLayout Padding="0,8" Spacing="4">
                        <Label Text="{Binding Speaker}" FontAttributes="Bold" FontSize="14" />
                        <Label Text="{Binding Content}" FontSize="16" />
                        <VerticalStackLayout BindingContextChanged="OnMessageActionsChanged" Spacing="4" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <HorizontalStackLayout x:Name="SessionActions" Grid.Row="2" Spacing="8">
            <Button x:Name="SignIn" Text="Sign in" Clicked="OnSignInClicked" />
            <Button x:Name="Refresh" Text="Refresh" Clicked="OnRefreshClicked" IsVisible="False" />
            <Button x:Name="Disconnect" Text="Sign out" Clicked="OnDisconnectClicked" IsVisible="False" />
        </HorizontalStackLayout>
        <Grid x:Name="Composer" Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
            <Editor x:Name="Draft" Placeholder="Message PersonalAgent" MaxLength="4000" MaximumHeightRequest="130" AutoSize="TextChanges" />
            <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked" />
        </Grid>
    </Grid>
</ContentPage>

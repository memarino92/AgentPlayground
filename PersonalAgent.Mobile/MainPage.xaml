<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalAgent.Mobile.MainPage"
             BackgroundColor="#f8fafc">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="12,10,12,8" RowSpacing="10">
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#0f172a" StrokeShape="RoundRectangle 14" Padding="12,10">
            <VerticalStackLayout Spacing="2">
                <Label Text="PersonalAgent Mobile" FontSize="18" FontAttributes="Bold" TextColor="#f8fafc" />
                <Label Text="2FA gateway + web companion" FontSize="12" TextColor="#cbd5e1" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Reload" Clicked="OnReloadClicked" BackgroundColor="#1e293b" TextColor="#f8fafc" CornerRadius="10" Padding="14,10" FontSize="13" />
            <Button Grid.Column="1" Text="Approve Pending" Clicked="OnOpenApprovalClicked" BackgroundColor="#166534" TextColor="#f0fdf4" CornerRadius="10" Padding="14,10" FontSize="13" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Button Text="Request 2FA" Clicked="OnRequestTestApprovalClicked" BackgroundColor="#0f766e" TextColor="#ecfeff" CornerRadius="10" Padding="14,10" FontSize="13" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Register Device" Clicked="OnRegisterDeviceClicked" BackgroundColor="#334155" TextColor="#f8fafc" CornerRadius="10" Padding="14,10" FontSize="13" />
                <Label Grid.Column="1" Text="{Binding StatusMessage}" VerticalOptions="Center" TextColor="#475569" LineBreakMode="TailTruncation" />
            </Grid>
        </VerticalStackLayout>

        <Label Grid.Row="3" Text="Web Preview" FontSize="12" TextColor="#64748b" />

        <Border Grid.Row="4" Stroke="#cbd5e1" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#ffffff" Padding="0" HeightRequest="260" VerticalOptions="Start">
            <WebView x:Name="AgentWebView" Source="{Binding WebAppUrl}" Navigated="OnWebViewNavigated" />
        </Border>
    </Grid>

</ContentPage>

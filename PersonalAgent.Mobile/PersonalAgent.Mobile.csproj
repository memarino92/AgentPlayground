<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PersonalAgent.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>PersonalAgent Mobile</ApplicationTitle>
    <ApplicationId>com.personalagent.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">$([System.Environment]::GetEnvironmentVariable('ANDROID_SDK_ROOT'))</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == ''">$([System.Environment]::GetEnvironmentVariable('JAVA_HOME'))</JavaSdkDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Plugin.Firebase.CloudMessaging" />
    <PackageReference Include="Plugin.Firebase.Core" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\appicon.svg" ForegroundFile="Resources\appiconfg.svg" Color="#166534" />
    <MauiSplashScreen Include="Resources\appiconfg.svg" Color="#f0fdf4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\google-services.json')">
    <GoogleServicesJson Include="..\google-services.json" Link="Platforms\Android\google-services.json" />
  </ItemGroup>

</Project>

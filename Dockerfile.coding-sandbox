FROM node:24-bookworm-slim AS tools
RUN npm install --global @opencode/cli@2.3.2

FROM mcr.microsoft.com/dotnet/sdk:11.0.100
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates ripgrep unzip libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*
ENV ANDROID_SDK_ROOT=/opt/android-sdk JAVA_HOME=/opt/android-jdk
RUN dotnet workload install maui-android --skip-manifest-update \
    && dotnet new android --output /tmp/android-dependencies \
    && dotnet build /tmp/android-dependencies -t:InstallAndroidDependencies \
        -p:AndroidSdkDirectory=$ANDROID_SDK_ROOT -p:JavaSdkDirectory=$JAVA_HOME -p:AcceptAndroidSDKLicenses=True \
    && test -x "$JAVA_HOME/bin/javac" \
    && rm -rf /tmp/android-dependencies
COPY --from=tools /usr/local/bin/node /usr/local/bin/node
COPY --from=tools /usr/local/lib/node_modules/@opencode/cli/bin/opencode.exe /usr/local/bin/opencode
RUN opencode --version
COPY PersonalAgent.Worker/Railway/workload.mjs PersonalAgent.Worker/Railway/coding-questions.mjs /opt/coding/
WORKDIR /work
ENTRYPOINT ["node", "/opt/coding/workload.mjs"]

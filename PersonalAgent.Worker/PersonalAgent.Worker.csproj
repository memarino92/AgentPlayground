<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-PersonalAgent.Worker-761b08e9-f978-41ba-a0d3-1d972b34363b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Railway/**" />
    <Content Include="Railway/bridge.mjs;Railway/coding.mjs;Railway/package.json;Railway/package-lock.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\PersonalAgent.Contracts\PersonalAgent.Contracts.csproj" />
    <ProjectReference Include="..\PersonalAgent.Integrations\PersonalAgent.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PersonalAgent.Worker.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.SqlTransport.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Pgvector" />
  </ItemGroup>
</Project>

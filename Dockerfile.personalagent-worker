FROM node:24-bookworm-slim AS railway
WORKDIR /railway
COPY PersonalAgent.Worker/Railway/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM docker:28-cli AS docker

FROM mcr.microsoft.com/dotnet/sdk:11.0.100-rc.1 AS build
WORKDIR /src

COPY ["global.json", "."]
COPY ["Directory.Build.props", "."]
COPY ["Directory.Packages.props", "."]
COPY ["PersonalAgent.Contracts/PersonalAgent.Contracts.csproj", "PersonalAgent.Contracts/"]
COPY ["PersonalAgent.Integrations/PersonalAgent.Integrations.csproj", "PersonalAgent.Integrations/"]
COPY ["PersonalAgent.Worker/PersonalAgent.Worker.csproj", "PersonalAgent.Worker/"]

RUN dotnet restore "PersonalAgent.Worker/PersonalAgent.Worker.csproj"

COPY . .
RUN dotnet publish "PersonalAgent.Worker/PersonalAgent.Worker.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:11.0.0-rc.1 AS final
WORKDIR /app
ENV DOTNET_ENVIRONMENT=Production

COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker
COPY --from=railway /usr/local/bin/node /usr/local/bin/node
COPY --from=build /app/publish .
COPY --from=railway /railway/node_modules ./Railway/node_modules

ENTRYPOINT ["dotnet", "PersonalAgent.Worker.dll"]

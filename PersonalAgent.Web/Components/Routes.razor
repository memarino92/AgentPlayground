@using System.Reflection
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView @key="AuthenticationState" RouteData="@routeData" DefaultLayout="typeof(Layout)">
            <NotAuthorized>
                <LayoutView Layout="typeof(Layout)">
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <div class="login-prompt">
                            <h2>You do not have access to this page</h2>
                        </div>
                    }
                    else
                    {
                        <div class="login-prompt">
                            <h2>Please log in to continue</h2>
                            <p>Use GitHub or Google to access PersonalAgent.</p>
                        </div>
                    }
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>Not Found</PageTitle>
        <p>Sorry, there's nothing at this address.</p>
    </NotFound>
</Router>

@code {
    // Recreate routed content on identity changes so cached subject data and drafts cannot cross accounts.
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
}

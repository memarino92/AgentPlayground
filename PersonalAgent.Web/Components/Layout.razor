@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page">
    <MudThemeProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudPopoverProvider />

    <header class="navbar">
        <div class="navbar__start">
            <div class="navbar-menu">
                <button type="button" popovertarget="site-menu" aria-label="Open menu">☰</button>
                <div class="navbar-menu__items" id="site-menu" popover="auto" @ref="MenuRoot">
                    <AuthorizeView Policy="@ServiceCollectionAuthenticationExtensions.CoachTranscriptPolicy">
                        <Authorized>
                            <a href="/chat?drawer=1" class="navbar-menu__link">Chats</a>
                            <a href="/jobs" class="navbar-menu__link">Scheduled jobs</a>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@ServiceCollectionAuthenticationExtensions.OwnerPolicy">
                        <Authorized>
                            <a href="/admin/settings" class="navbar-menu__link">Settings</a>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@ServiceCollectionAuthenticationExtensions.CoachTranscriptPolicy">
                        <Authorized>
                            <a href="/coach-checkins/admin" class="navbar-menu__link">Coach check-ins</a>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>

            <div class="navbar__title">
            <h1>PersonalAgent</h1>
            </div>
        </div>
        <div class="navbar__actions">
            <AuthorizeView>
                <Authorized>
                    <span class="user-info">
                        @context.User.FindFirst(ClaimTypes.Name)?.Value
                    </span>
                    <form method="post" action="/logout">
                        <button type="submit" class="btn btn-logout">Log out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="btn btn-login">Log in with GitHub</a>
                    <a href="login?provider=Google" class="btn btn-login">Log in with Google</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="main">
        @Body
    </main>
</div>

@code {
    private ElementReference MenuRoot;
    private MenuInterop? Menu;
    protected override async Task OnAfterRenderAsync(bool FirstRender)
    {
        if (!FirstRender) return;
        Menu = new(JS);
        await Menu.InitializeAsync(MenuRoot);
    }
    public async ValueTask DisposeAsync()
    {
        if (Menu is not null) await Menu.DisposeAsync();
    }
}

@inherits LayoutComponentBase
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page">
    <MudThemeProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudPopoverProvider />

    <header class="navbar">
        <div class="navbar__start">
            <details class="navbar-menu">
                <summary aria-label="Open menu">☰</summary>
                <div class="navbar-menu__items">
                    <AuthorizeView Policy="@ServiceCollectionAuthenticationExtensions.CoachTranscriptPolicy">
                        <Authorized>
                            <a href="/chat?drawer=1" class="navbar-menu__link">Sessions</a>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@ServiceCollectionAuthenticationExtensions.OwnerPolicy">
                        <Authorized>
                            <a href="/coach-checkins/admin" class="navbar-menu__link">Coach check-ins</a>
                            <a href="/admin/integrations" class="navbar-menu__link">Integrations</a>
                            <a href="/admin/settings" class="navbar-menu__link">Application settings</a>
                            <a href="/admin/integration-settings" class="navbar-menu__link">Sentry settings</a>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@ServiceCollectionAuthenticationExtensions.CoachTranscriptPolicy">
                        <Authorized>
                            <a href="/coach-transcripts" class="navbar-menu__link">Transcripts</a>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </details>

            <div class="navbar__title">
            <h1>PersonalAgent</h1>
            </div>
        </div>
        <div class="navbar__actions">
            <AuthorizeView>
                <Authorized>
                    <span class="user-info">
                        @context.User.FindFirst(ClaimTypes.Name)?.Value
                    </span>
                    <form method="post" action="/logout">
                        <button type="submit" class="btn btn-logout">Log out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="btn btn-login">Log in with GitHub</a>
                    <a href="login?provider=Google" class="btn btn-login">Log in with Google</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="main">
        @Body
    </main>
</div>


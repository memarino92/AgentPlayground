@if (SelectedItem is null)
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6">Transcript detail</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">Select an upload to review transcript content and apply speaker overrides.</MudText>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4 coach-admin-detail" Elevation="1">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="coach-admin-detail__header">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@SelectedItem.OriginalFileName</MudText>
                    <MudText Typo="Typo.caption">Upload @SelectedItem.UploadId</MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(SelectedItem.Status)" Variant="Variant.Filled">@SelectedItem.Status</MudChip>
            </MudStack>

            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Profile: @SelectedItem.ProfileId</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Updated: @SelectedItem.UpdatedAtUtc.ToLocalTime().ToString("g")</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Utterances: @SelectedItem.UtteranceCount</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Chunks: @SelectedItem.ChunkCount</MudChip>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(SelectedItem.Error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@SelectedItem.Error</MudAlert>
            }

            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsLoadingTranscript"
                           OnClick="() => OnLoadTranscript.InvokeAsync(SelectedItem.UploadId)">
                    @(IsLoadingTranscript ? "Loading transcript..." : "Load transcript")
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Disabled="@IsDownloadingTranscript"
                           OnClick="() => OnDownloadTranscript.InvokeAsync(SelectedItem.UploadId)">
                    @(IsDownloadingTranscript ? "Preparing download..." : "Download .txt")
                </MudButton>
            </MudStack>

            @if (SelectedItem.SpeakerLabels.Count > 0)
            {
                <MudDivider />
                <details class="coach-admin-detail__overrides" @attributes="GetOverridesOpenAttribute()">
                    <summary>Speaker labels (@SelectedItem.SpeakerLabels.Count)</summary>
                    <MudStack Spacing="2" Class="mt-2">
                        <MudGrid>
                            @foreach (var label in SelectedItem.SpeakerLabels.OrderBy(label => label.SpeakerLabel))
                            {
                                <MudItem xs="12" md="6">
                                    <MudPaper Class="pa-3" Outlined="true">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">Label @label.SpeakerLabel (@label.UtteranceCount utterances)</MudText>
                                            <MudSelect T="string"
                                                       Label="Role"
                                                       Dense="true"
                                                       Value="@GetOverrideSelection(label)"
                                                       ValueChanged="(role) => OnRoleChanged.InvokeAsync(new SpeakerRoleChanged(SelectedItem.UploadId, label.SpeakerLabel, role))"
                                                       Disabled="@IsApplyingOverride">
                                                <MudSelectItem Value="@("coach")">coach</MudSelectItem>
                                                <MudSelectItem Value="@("athlete")">athlete</MudSelectItem>
                                                <MudSelectItem Value="@("unknown")">unknown</MudSelectItem>
                                            </MudSelect>
                                            @if (NormalizeRole(label.SpeakerRole) == "unknown" && label.SampleTexts.Count > 0)
                                            {
                                                <MudText Typo="Typo.caption">Samples:</MudText>
                                                <ul class="coach-admin-detail__samples">
                                                    @foreach (var sample in label.SampleTexts)
                                                    {
                                                        <li>@sample</li>
                                                    }
                                                </ul>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   Disabled="@IsApplyingOverride"
                                   OnClick="() => OnApplyOverride.InvokeAsync(SelectedItem)">
                            @(IsApplyingOverride ? "Applying..." : "Apply speaker override")
                        </MudButton>
                    </MudStack>
                </details>
            }

            <MudDivider />
            <MudText Typo="Typo.subtitle1">Transcript timeline</MudText>

            @if (!string.IsNullOrWhiteSpace(TranscriptError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@TranscriptError</MudAlert>
            }
            else if (Transcript is null)
            {
                <MudText Typo="Typo.body2">Transcript not loaded yet.</MudText>
            }
            else if (Transcript.Utterances.Count is 0)
            {
                <MudText Typo="Typo.body2">No utterances are available for this transcript yet.</MudText>
            }
            else
            {
                <div class="coach-admin-detail__timeline">
                    @foreach (var utterance in Transcript.Utterances)
                    {
                        <div class="coach-admin-detail__utterance" data-role="@NormalizeRole(utterance.SpeakerRole)">
                            <div class="coach-admin-detail__utterance-meta">
                                <span class="coach-admin-detail__role">@NormalizeRole(utterance.SpeakerRole)</span>
                                <span>@FormatTimestampRange(utterance.StartMs, utterance.EndMs)</span>
                            </div>
                            <div class="coach-admin-detail__utterance-text">@utterance.Text</div>
                        </div>
                    }
                </div>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public required CoachCheckinAdminItemResponse? SelectedItem { get; set; }
    [Parameter] public required CoachCheckinTranscriptResponse? Transcript { get; set; }
    [Parameter] public required string? TranscriptError { get; set; }
    [Parameter] public required bool IsLoadingTranscript { get; set; }
    [Parameter] public required bool IsDownloadingTranscript { get; set; }
    [Parameter] public required bool IsApplyingOverride { get; set; }
    [Parameter] public required EventCallback<Guid> OnLoadTranscript { get; set; }
    [Parameter] public required EventCallback<Guid> OnDownloadTranscript { get; set; }
    [Parameter] public required EventCallback<CoachCheckinAdminItemResponse> OnApplyOverride { get; set; }
    [Parameter] public required EventCallback<SpeakerRoleChanged> OnRoleChanged { get; set; }
    [Parameter] public required Func<CoachCheckinSpeakerLabelInfoResponse, string> GetOverrideSelection { get; set; }

    private static string NormalizeRole(string? role)
    {
        if (string.Equals(role, "coach", StringComparison.OrdinalIgnoreCase)) return "coach";
        if (string.Equals(role, "athlete", StringComparison.OrdinalIgnoreCase)) return "athlete";
        return "unknown";
    }

    private bool NeedsSpeakerSamples => SelectedItem?.SpeakerLabels.Any(label => NormalizeRole(label.SpeakerRole) == "unknown") is true;

    private IReadOnlyDictionary<string, object> GetOverridesOpenAttribute() => NeedsSpeakerSamples
        ? new Dictionary<string, object> { ["open"] = "open" }
        : new Dictionary<string, object>();

    private static string FormatTimestampRange(int startMs, int endMs) => $"{FormatTimestamp(startMs)} - {FormatTimestamp(endMs)}";
    private static string FormatTimestamp(int milliseconds) => TimeSpan.FromMilliseconds(milliseconds).ToString(@"mm\:ss");

    private static Color GetRoleColor(string? role) => NormalizeRole(role) switch
    {
        "coach" => Color.Success,
        "athlete" => Color.Info,
        _ => Color.Default
    };

    private static Color GetStatusColor(string status)
    {
        if (string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)) return Color.Success;
        if (string.Equals(status, "AwaitingSpeakerOverride", StringComparison.OrdinalIgnoreCase)) return Color.Warning;
        if (string.Equals(status, "Failed", StringComparison.OrdinalIgnoreCase)) return Color.Error;
        return Color.Info;
    }
}

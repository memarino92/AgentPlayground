<MudPaper Class="pa-3 session-panel" Elevation="1" id="chat-drawer">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">Previous chats</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="OnCloseDrawer">Close</MudButton>
        </MudStack>

        @if (IsLoadingSessions)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        @if (Sessions.Count == 0 && !IsLoadingSessions)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No chats yet.</MudAlert>
        }
        else
        {
            <div class="session-panel__list">
                @foreach (var session in Sessions)
                {
                    var isSelected = session.SessionId == SelectedSessionOption;
                    <button type="button"
                            class="session-panel__entry @(isSelected ? "session-panel__entry--active" : string.Empty)"
                            @onclick="() => OnSessionSelectionChanged.InvokeAsync(session.SessionId)"
                            disabled="@IsBusy">
                        <strong>@session.Snippet</strong>
                        <span>@session.LastActivityAt.ToLocalTime().ToString("g")</span>
                    </button>
                }
            </div>

            @if (HasMoreSessions)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="OnLoadMoreSessions" Disabled="@(IsBusy || IsLoadingSessions)">
                    Load more
                </MudButton>
            }
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public required List<SessionListItem> Sessions { get; set; }
    [Parameter] public required bool IsLoadingSessions { get; set; }
    [Parameter] public required bool IsBusy { get; set; }
    [Parameter] public required bool HasMoreSessions { get; set; }
    [Parameter] public required string SelectedSessionOption { get; set; }
    [Parameter] public required EventCallback<string?> OnSessionSelectionChanged { get; set; }
    [Parameter] public required EventCallback OnLoadMoreSessions { get; set; }
    [Parameter] public required EventCallback OnCloseDrawer { get; set; }
}

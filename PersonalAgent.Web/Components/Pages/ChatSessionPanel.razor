<aside class="session-panel" id="chat-drawer">
    <div class="session-panel__summary">
        <span>Previous chats</span>
        <button class="session-panel__close" @onclick="OnCloseDrawer">Close</button>
        @if (IsLoadingSessions)
        {
            <span class="session-panel__status">Loading...</span>
        }
    </div>

    @if (Sessions.Count == 0 && !IsLoadingSessions)
    {
        <p class="session-panel__empty">No chats yet.</p>
    }
    else
    {
        <ul class="session-panel__list">
            @foreach (var session in Sessions)
            {
                <li class="session-panel__item">
                    <button class="session-panel__button session-panel__button--@(session.SessionId == SelectedSessionOption ? "active" : "inactive")"
                            @onclick="() => OnSessionSelectionChanged.InvokeAsync(session.SessionId)"
                            disabled="@IsBusy">
                        @FormatSessionOption(session)
                    </button>
                </li>
            }
        </ul>

        @if (HasMoreSessions)
        {
            <button class="session-panel__more" @onclick="OnLoadMoreSessions" disabled="@(IsBusy || IsLoadingSessions)">
                Load more
            </button>
        }
    }
</aside>

@code {
    [Parameter] public required List<SessionListItem> Sessions { get; set; }
    [Parameter] public required bool IsLoadingSessions { get; set; }
    [Parameter] public required bool IsBusy { get; set; }
    [Parameter] public required bool HasMoreSessions { get; set; }
    [Parameter] public required string SelectedSessionOption { get; set; }
    [Parameter] public required Func<SessionListItem, string> FormatSessionOption { get; set; }
    [Parameter] public required EventCallback<string?> OnSessionSelectionChanged { get; set; }
    [Parameter] public required EventCallback OnLoadMoreSessions { get; set; }
    [Parameter] public required EventCallback OnCloseDrawer { get; set; }
}

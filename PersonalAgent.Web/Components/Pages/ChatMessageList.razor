@using Markdig
@using Markdig.Syntax
@using Markdig.Syntax.Inlines
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="message-list" id="@ContainerId" @ref="Root">
    @foreach (var msg in Messages)
    {
        <div class="message-list__item message-list__item--@msg.Role @(msg.Sequence == HighlightSequence ? "message-list__item--highlight" : null)" data-role="@msg.Role" data-sequence="@msg.Sequence">
            <strong>@(msg.Role == "user" ? "You" : "Garden")</strong>
            @if (msg.Role == "assistant")
            {
                <div class="message-list__content">
                    @if (IsSendingMessage && string.IsNullOrEmpty(msg.Content))
                    {
                        <p class="chat-thinking" role="status">Putting a response together…</p>
                    }
                    else
                    {
                        @((MarkupString)RenderMarkdown(msg.Content))
                    }
                    @foreach (var Citation in EvidenceCitation.Parse(msg.Content, ProfileId))
                    {
                        <button type="button" data-evidence-url="@Citation.Url" @onclick="() => SelectedEvidence = Citation">Open call evidence @(Citation.StartMs is int Start ? TimeSpan.FromMilliseconds(Start).ToString(@"hh\:mm\:ss") : "(timing unavailable)")</button>
                    }
                    @if (msg.Presentation is { } Presentation)
                    {
                        <ChatResponseCards Cards="Presentation.Cards" Sequence="msg.Sequence" Disabled="@(IsSendingMessage || IsReadOnly || IsUpdatingCard)" OnAction="OnCardAction" />
                        @if (Presentation.Sources.Count > 0)
                        {
                            <details class="chat-context">
                                <summary>Earlier context considered · @Presentation.Sources.Count</summary>
                                @foreach (var Source in Presentation.Sources)
                                {
                                    <a href="@($"/chat?sessionId={Source.SessionId}&profileId={Uri.EscapeDataString(ProfileId ?? string.Empty)}&message={Source.Sequence}")">@Source.CreatedAt.ToLocalTime().ToString("MMM d") · @Source.Excerpt</a>
                                }
                            </details>
                        }
                    }
                </div>
            }
            else
            {
                <div class="message-list__content">@msg.Content</div>
            }
        </div>
    }

    @if (IsSendingMessage && (Messages.Count == 0 || Messages[^1].Role != "assistant"))
    {
        <div class="message-list__item message-list__item--assistant" data-role="assistant">
            <strong>Garden</strong>
            <p class="chat-thinking" role="status">Putting a response together…</p>
        </div>
    }
</div>
@if (SelectedEvidence is not null)
{
    <EvidenceDrawer @key="SelectedEvidence" UploadId="SelectedEvidence.UploadId" ProfileId="@SelectedEvidence.ProfileId" StartMs="SelectedEvidence.StartMs" OnClose="() => SelectedEvidence = null" />
}

@code {
    private EvidenceCitation? SelectedEvidence;
    private ElementReference Root;
    private EvidenceLinksInterop? EvidenceLinks;
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .DisableHtml()
        .Build();

    [Parameter] public required List<ConversationMessage> Messages { get; set; }
    [Parameter] public required bool IsSendingMessage { get; set; }
    [Parameter] public required string ContainerId { get; set; }
    [Parameter] public string? ProfileId { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool IsUpdatingCard { get; set; }
    [Parameter] public EventCallback<ChatCardInteraction> OnCardAction { get; set; }
    [Parameter] public long? HighlightSequence { get; set; }
    private long? LastHighlight;

    private string RenderMarkdown(string Content)
    {
        var Document = Markdown.Parse(Content, MarkdownPipeline);
        foreach (var Link in Document.Descendants<LinkInline>())
        {
            if (Link.IsImage || EvidenceCitation.FromUrl(Link.Url, ProfileId) is not { } Citation) continue;
            Link.Url = Citation.Url;
        }
        return Markdown.ToHtml(Document, MarkdownPipeline).Trim();
    }

    protected override async Task OnAfterRenderAsync(bool FirstRender)
    {
        if (FirstRender)
        {
            EvidenceLinks = new(JS);
            await EvidenceLinks.InitializeAsync(Root);
        }
        if (HighlightSequence is { } Sequence && LastHighlight != Sequence && Messages.Any(Message => Message.Sequence == Sequence) && EvidenceLinks is not null)
        {
            await EvidenceLinks.RevealMessageAsync(Sequence);
            LastHighlight = Sequence;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (EvidenceLinks is not null) await EvidenceLinks.DisposeAsync();
    }
}

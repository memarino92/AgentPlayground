@using Markdig

<div class="message-list" id="@ContainerId">
    @foreach (var msg in Messages)
    {
        <div class="message-list__item message-list__item--@msg.Role" data-role="@msg.Role">
            <strong>@(msg.Role == "user" ? "You" : msg.Role)</strong>
            @if (msg.Role == "assistant")
            {
                <div class="message-list__content">
                    @((MarkupString)RenderMarkdown(msg.Content))
                    @foreach (var Citation in EvidenceCitation.Parse(msg.Content))
                    {
                        <button type="button" @onclick="() => SelectedEvidence = Citation">Open call evidence @(Citation.StartMs is int Start ? TimeSpan.FromMilliseconds(Start).ToString(@"hh\:mm\:ss") : "(timing unavailable)")</button>
                    }
                </div>
            }
            else
            {
                <div class="message-list__content">@msg.Content</div>
            }
        </div>
    }

    @if (IsSendingMessage)
    {
        <div class="message-list__item message-list__item--assistant" data-role="assistant">
            <strong>assistant</strong>
            <p><em>Thinking...</em></p>
        </div>
    }
</div>
@if (SelectedEvidence is not null)
{
    <EvidenceDrawer @key="SelectedEvidence" UploadId="SelectedEvidence.UploadId" ProfileId="@SelectedEvidence.ProfileId" StartMs="SelectedEvidence.StartMs" OnClose="() => SelectedEvidence = null" />
}

@code {
    private EvidenceCitation? SelectedEvidence;
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .DisableHtml()
        .Build();

    [Parameter] public required List<ConversationMessage> Messages { get; set; }
    [Parameter] public required bool IsSendingMessage { get; set; }
    [Parameter] public required string ContainerId { get; set; }

    private static string RenderMarkdown(string content) => Markdown.ToHtml(content, MarkdownPipeline).Trim();
}

@page "/coach-checkins/admin"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@inject PersonalAgentClient ApiClient
@inject ILogger<CoachCheckinsAdmin> Logger

<PageTitle>PersonalAgent - Coach Check-ins Admin</PageTitle>

<section class="coach-admin-page">
    <h2>Coach Check-ins Admin</h2>
    <button class="btn btn-secondary" @onclick="LoadAsync" disabled="@isLoading">Refresh</button>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p>@errorMessage</p>
    }

    @if (isLoading)
    {
        <p>Loading requests...</p>
    }
    else if (items.Count is 0)
    {
        <p>No coach check-in requests found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Created</th>
                    <th>Profile</th>
                    <th>File</th>
                    <th>Status</th>
                    <th>Utterances</th>
                    <th>Chunks</th>
                    <th>Audio Blob</th>
                    <th>Speakers</th>
                    <th>Transcript</th>
                    <th>Override</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                        <td>@item.ProfileId</td>
                        <td>@item.OriginalFileName</td>
                        <td>@item.Status</td>
                        <td>@item.UtteranceCount</td>
                        <td>@item.ChunkCount</td>
                        <td>@(item.HasAudioBlob ? "Yes" : "No")</td>
                        <td>
                            @if (item.SpeakerLabels.Count is 0)
                            {
                                <span>-</span>
                            }
                            else
                            {
                                @string.Join(", ", item.SpeakerLabels.Select(label => $"{label.SpeakerLabel}:{label.SpeakerRole} ({label.UtteranceCount})"))
                            }
                        </td>
                        <td>
                            <button
                                class="btn btn-secondary"
                                @onclick="() => ToggleTranscriptAsync(item)"
                                disabled="@loadingTranscriptUploadIds.Contains(item.UploadId)">
                                @GetTranscriptButtonText(item.UploadId)
                            </button>
                        </td>
                        <td>
                            @if (item.SpeakerLabels.Count > 0)
                            {
                                <div>
                                    @foreach (var label in item.SpeakerLabels.OrderBy(label => label.SpeakerLabel))
                                    {
                                        <div class="speaker-override-row">
                                            <label>
                                                @label.SpeakerLabel:
                                                <select value="@GetOverrideSelection(item.UploadId, label)" @onchange="(args) => SetOverrideSelection(item.UploadId, label.SpeakerLabel, args.Value?.ToString())" disabled="@isApplyingOverride">
                                                    <option value="coach">coach</option>
                                                    <option value="athlete">athlete</option>
                                                    <option value="unknown">unknown</option>
                                                </select>
                                            </label>
                                            @if (label.SampleTexts.Count > 0)
                                            {
                                                <ul class="speaker-sample-texts">
                                                    @foreach (var sample in label.SampleTexts)
                                                    {
                                                        <li>@sample</li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    }
                                    <button class="btn btn-primary" @onclick="() => ApplyOverrideAsync(item)" disabled="@isApplyingOverride">Apply</button>
                                </div>
                            }
                        </td>
                        <td>@item.Error</td>
                    </tr>

                    @if (expandedTranscriptUploadIds.Contains(item.UploadId))
                    {
                        <tr class="coach-admin-transcript-row">
                            <td colspan="11">
                                @if (loadingTranscriptUploadIds.Contains(item.UploadId))
                                {
                                    <p>Loading transcript...</p>
                                }
                                else if (transcriptErrorsByUploadId.TryGetValue(item.UploadId, out var transcriptError) && !string.IsNullOrWhiteSpace(transcriptError))
                                {
                                    <p>@transcriptError</p>
                                }
                                else if (transcriptsByUploadId.TryGetValue(item.UploadId, out var transcript))
                                {
                                    <section class="coach-admin-transcript-viewer">
                                        <header class="coach-admin-transcript-viewer__header">
                                            <strong>Transcript timeline</strong>
                                            <span>Updated @transcript.UpdatedAtUtc.ToLocalTime().ToString("g")</span>
                                        </header>

                                        @if (transcript.Utterances.Count is 0)
                                        {
                                            <p>No utterances available yet.</p>
                                        }
                                        else
                                        {
                                            <div class="coach-admin-transcript-viewer__list">
                                                @foreach (var utterance in transcript.Utterances)
                                                {
                                                    <article class="coach-admin-transcript-viewer__item">
                                                        <div class="coach-admin-transcript-viewer__meta">
                                                            <span class="coach-admin-transcript-viewer__role @GetRoleClass(utterance.SpeakerRole)">@NormalizeRole(utterance.SpeakerRole)</span>
                                                            <span>Label @utterance.SpeakerLabel</span>
                                                            <span>@FormatTimestampRange(utterance.StartMs, utterance.EndMs)</span>
                                                        </div>
                                                        <p>@utterance.Text</p>
                                                    </article>
                                                }
                                            </div>
                                        }
                                    </section>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@code {
    private bool isLoading;
    private bool isApplyingOverride;
    private string? errorMessage;
    private List<CoachCheckinAdminItemResponse> items = [];
    private readonly Dictionary<Guid, Dictionary<int, string>> overrideSelections = [];
    private readonly HashSet<Guid> expandedTranscriptUploadIds = [];
    private readonly HashSet<Guid> loadingTranscriptUploadIds = [];
    private readonly Dictionary<Guid, string> transcriptErrorsByUploadId = [];
    private readonly Dictionary<Guid, CoachCheckinTranscriptResponse> transcriptsByUploadId = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            items = await ApiClient.GetCoachCheckinAdminItemsAsync();
            Logger.LogInformation("Loaded {Count} coach check-in admin items", items.Count);

            overrideSelections.Clear();
            foreach (var item in items)
            {
                overrideSelections[item.UploadId] = item.SpeakerLabels
                    .GroupBy(label => label.SpeakerLabel)
                    .ToDictionary(
                        group => group.Key,
                        group => group.Select(label => NormalizeRole(label.SpeakerRole)).Distinct().Count() == 1
                            ? group.Select(label => NormalizeRole(label.SpeakerRole)).First()
                            : "unknown");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load coach check-in admin items");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyOverrideAsync(CoachCheckinAdminItemResponse item)
    {
        if (!overrideSelections.TryGetValue(item.UploadId, out var selectionMap) || selectionMap.Count is 0)
        {
            errorMessage = "No speaker override choices found for this upload.";
            return;
        }

        var overrides = selectionMap
            .OrderBy(entry => entry.Key)
            .Select(entry => new SpeakerOverrideItem(entry.Key, entry.Value))
            .ToList();

        isApplyingOverride = true;
        errorMessage = null;

        try
        {
            await ApiClient.ApplySpeakerOverridesAsync(item.UploadId, item.ProfileId, overrides);
            Logger.LogInformation("Applied speaker override for upload {UploadId}", item.UploadId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to apply speaker override for upload {UploadId}", item.UploadId);
            errorMessage = ex.Message;
        }
        finally
        {
            isApplyingOverride = false;
        }
    }

    private string GetOverrideSelection(Guid uploadId, CoachCheckinSpeakerLabelInfoResponse label)
    {
        if (!overrideSelections.TryGetValue(uploadId, out var selections))
        {
            selections = [];
            overrideSelections[uploadId] = selections;
        }

        if (!selections.TryGetValue(label.SpeakerLabel, out var selectedRole))
        {
            selectedRole = NormalizeRole(label.SpeakerRole);
            selections[label.SpeakerLabel] = selectedRole;
        }

        return selectedRole;
    }

    private void SetOverrideSelection(Guid uploadId, int speakerLabel, string? role)
    {
        var normalizedRole = NormalizeRole(role);
        if (!overrideSelections.TryGetValue(uploadId, out var selections))
        {
            selections = [];
            overrideSelections[uploadId] = selections;
        }

        selections[speakerLabel] = normalizedRole;
    }

    private static string NormalizeRole(string? role)
    {
        if (string.Equals(role, "coach", StringComparison.OrdinalIgnoreCase)) return "coach";
        if (string.Equals(role, "athlete", StringComparison.OrdinalIgnoreCase)) return "athlete";
        return "unknown";
    }

    private async Task ToggleTranscriptAsync(CoachCheckinAdminItemResponse item)
    {
        transcriptErrorsByUploadId.Remove(item.UploadId);

        if (expandedTranscriptUploadIds.Contains(item.UploadId))
        {
            expandedTranscriptUploadIds.Remove(item.UploadId);
            return;
        }

        expandedTranscriptUploadIds.Add(item.UploadId);
        if (transcriptsByUploadId.ContainsKey(item.UploadId)) return;
        await LoadTranscriptAsync(item.UploadId);
    }

    private async Task LoadTranscriptAsync(Guid uploadId)
    {
        if (loadingTranscriptUploadIds.Contains(uploadId)) return;

        loadingTranscriptUploadIds.Add(uploadId);
        transcriptErrorsByUploadId.Remove(uploadId);
        try
        {
            var transcript = await ApiClient.GetCoachCheckinTranscriptAsync(uploadId);
            if (transcript is null)
            {
                transcriptErrorsByUploadId[uploadId] = "Transcript not found.";
                return;
            }

            transcriptsByUploadId[uploadId] = transcript;
        }
        catch (Exception ex)
        {
            transcriptErrorsByUploadId[uploadId] = ex.Message;
            Logger.LogError(ex, "Failed to load transcript for upload {UploadId}", uploadId);
        }
        finally
        {
            loadingTranscriptUploadIds.Remove(uploadId);
        }
    }

    private string GetTranscriptButtonText(Guid uploadId)
    {
        if (loadingTranscriptUploadIds.Contains(uploadId)) return "Loading...";
        return expandedTranscriptUploadIds.Contains(uploadId) ? "Hide transcript" : "View transcript";
    }

    private static string FormatTimestampRange(int startMs, int endMs) => $"{FormatTimestamp(startMs)} - {FormatTimestamp(endMs)}";
    private static string FormatTimestamp(int milliseconds) => TimeSpan.FromMilliseconds(milliseconds).ToString(@"mm\:ss");

    private static string GetRoleClass(string role) => NormalizeRole(role) switch
    {
        "coach" => "coach-admin-transcript-viewer__role--coach",
        "athlete" => "coach-admin-transcript-viewer__role--athlete",
        _ => "coach-admin-transcript-viewer__role--unknown"
    };
}

@page "/coach-checkins/admin"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@inject PersonalAgentClient ApiClient
@inject ILogger<CoachCheckinsAdmin> Logger
@inject IJSRuntime JsRuntime

<PageTitle>PersonalAgent - Coach Check-ins Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="coach-admin-page">
    <MudGrid>
        <MudItem xs="12" md="4" lg="4">
            <UploadQueuePanel Items="items"
                              IsLoading="isLoading"
                              SelectedUploadId="selectedUploadId"
                              OnSelectUpload="SelectUploadAsync"
                              OnRefresh="LoadAsync" />
        </MudItem>
        <MudItem xs="12" md="8" lg="8">
            <UploadDetailPanel SelectedItem="SelectedItem"
                               Transcript="SelectedTranscript"
                               TranscriptError="@SelectedTranscriptError"
                               IsLoadingTranscript="IsLoadingSelectedTranscript"
                               IsDownloadingTranscript="isDownloadingTranscript"
                               IsApplyingOverride="isApplyingOverride"
                               OnLoadTranscript="LoadTranscriptAsync"
                               OnDownloadTranscript="DownloadTranscriptAsync"
                               OnApplyOverride="ApplyOverrideAsync"
                               OnRoleChanged="HandleRoleChanged"
                               GetOverrideSelection="GetOverrideSelectionForSelectedItem" />
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@errorMessage</MudAlert>
    }
</MudContainer>

@code {
    private bool isLoading;
    private bool isApplyingOverride;
    private bool isDownloadingTranscript;
    private string? errorMessage;
    private List<CoachCheckinAdminItemResponse> items = [];
    private readonly Dictionary<Guid, Dictionary<int, string>> overrideSelections = [];
    private Guid? selectedUploadId;
    private readonly HashSet<Guid> loadingTranscriptUploadIds = [];
    private readonly Dictionary<Guid, string> transcriptErrorsByUploadId = [];
    private readonly Dictionary<Guid, CoachCheckinTranscriptResponse> transcriptsByUploadId = [];

    private CoachCheckinAdminItemResponse? SelectedItem => selectedUploadId is null
        ? null
        : items.FirstOrDefault(item => item.UploadId == selectedUploadId.Value);

    private CoachCheckinTranscriptResponse? SelectedTranscript => selectedUploadId is not null && transcriptsByUploadId.TryGetValue(selectedUploadId.Value, out var transcript)
        ? transcript
        : null;

    private string? SelectedTranscriptError => selectedUploadId is not null && transcriptErrorsByUploadId.TryGetValue(selectedUploadId.Value, out var transcriptError)
        ? transcriptError
        : null;

    private bool IsLoadingSelectedTranscript => selectedUploadId is not null && loadingTranscriptUploadIds.Contains(selectedUploadId.Value);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            items = await ApiClient.GetCoachCheckinAdminItemsAsync();
            Logger.LogInformation("Loaded {Count} coach check-in admin items", items.Count);

            overrideSelections.Clear();
            foreach (var item in items)
            {
                overrideSelections[item.UploadId] = item.SpeakerLabels
                    .GroupBy(label => label.SpeakerLabel)
                    .ToDictionary(
                        group => group.Key,
                        group => group.Select(label => NormalizeRole(label.SpeakerRole)).Distinct().Count() == 1
                            ? group.Select(label => NormalizeRole(label.SpeakerRole)).First()
                            : "unknown");
            }

            if (selectedUploadId is null || items.All(item => item.UploadId != selectedUploadId.Value))
                selectedUploadId = items.FirstOrDefault()?.UploadId;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load coach check-in admin items");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyOverrideAsync(CoachCheckinAdminItemResponse item)
    {
        if (!overrideSelections.TryGetValue(item.UploadId, out var selectionMap) || selectionMap.Count is 0)
        {
            errorMessage = "No speaker override choices found for this upload.";
            return;
        }

        var overrides = selectionMap
            .OrderBy(entry => entry.Key)
            .Select(entry => new SpeakerOverrideItem(entry.Key, entry.Value))
            .ToList();

        isApplyingOverride = true;
        errorMessage = null;

        try
        {
            await ApiClient.ApplySpeakerOverridesAsync(item.UploadId, item.ProfileId, overrides);
            Logger.LogInformation("Applied speaker override for upload {UploadId}", item.UploadId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to apply speaker override for upload {UploadId}", item.UploadId);
            errorMessage = ex.Message;
        }
        finally
        {
            isApplyingOverride = false;
        }
    }

    private string GetOverrideSelection(Guid uploadId, int speakerLabel, string? defaultRole)
    {
        if (!overrideSelections.TryGetValue(uploadId, out var selections))
        {
            selections = [];
            overrideSelections[uploadId] = selections;
        }

        if (!selections.TryGetValue(speakerLabel, out var selectedRole))
        {
            selectedRole = NormalizeRole(defaultRole);
            selections[speakerLabel] = selectedRole;
        }

        return selectedRole;
    }

    private string GetOverrideSelectionForSelectedItem(CoachCheckinSpeakerLabelInfoResponse label)
    {
        if (selectedUploadId is null) return NormalizeRole(label.SpeakerRole);
        return GetOverrideSelection(selectedUploadId.Value, label.SpeakerLabel, label.SpeakerRole);
    }

    private void SetOverrideSelection(Guid uploadId, int speakerLabel, string? role)
    {
        var normalizedRole = NormalizeRole(role);
        if (!overrideSelections.TryGetValue(uploadId, out var selections))
        {
            selections = [];
            overrideSelections[uploadId] = selections;
        }

        selections[speakerLabel] = normalizedRole;
    }

    private static string NormalizeRole(string? role)
    {
        if (string.Equals(role, "coach", StringComparison.OrdinalIgnoreCase)) return "coach";
        if (string.Equals(role, "athlete", StringComparison.OrdinalIgnoreCase)) return "athlete";
        return "unknown";
    }

    private async Task SelectUploadAsync(Guid uploadId)
    {
        selectedUploadId = uploadId;
        if (transcriptsByUploadId.ContainsKey(uploadId) || loadingTranscriptUploadIds.Contains(uploadId)) return;
        await LoadTranscriptAsync(uploadId);
    }

    private async Task HandleRoleChanged(SpeakerRoleChanged change)
    {
        SetOverrideSelection(change.UploadId, change.SpeakerLabel, change.Role);
        await Task.CompletedTask;
    }

    private async Task DownloadTranscriptAsync(Guid uploadId)
    {
        isDownloadingTranscript = true;
        errorMessage = null;
        try
        {
            var download = await ApiClient.DownloadCoachCheckinTranscriptAsync(uploadId);
            var base64 = Convert.ToBase64String(download.Bytes);
            await JsRuntime.InvokeVoidAsync("downloadTextFileFromBase64", download.FileName, base64, "text/plain;charset=utf-8");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download transcript for upload {UploadId}", uploadId);
            errorMessage = ex.Message;
        }
        finally
        {
            isDownloadingTranscript = false;
        }
    }

    private async Task LoadTranscriptAsync(Guid uploadId)
    {
        if (loadingTranscriptUploadIds.Contains(uploadId)) return;

        loadingTranscriptUploadIds.Add(uploadId);
        transcriptErrorsByUploadId.Remove(uploadId);
        try
        {
            var transcript = await ApiClient.GetCoachCheckinTranscriptAsync(uploadId);
            if (transcript is null)
            {
                transcriptErrorsByUploadId[uploadId] = "Transcript not found.";
                return;
            }

            transcriptsByUploadId[uploadId] = transcript;
        }
        catch (Exception ex)
        {
            transcriptErrorsByUploadId[uploadId] = ex.Message;
            Logger.LogError(ex, "Failed to load transcript for upload {UploadId}", uploadId);
        }
        finally
        {
            loadingTranscriptUploadIds.Remove(uploadId);
        }
    }
}

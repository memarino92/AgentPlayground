@page "/coach-checkins/admin"
@page "/coach-transcripts"
@attribute [Authorize(Policy = ServiceCollectionAuthenticationExtensions.CoachTranscriptPolicy)]
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PersonalAgentClient ApiClient
@inject ILogger<CoachCheckinsAdmin> Logger
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<PageTitle>PersonalAgent - Coach check-ins</PageTitle>
<CoachCallLiveRefresh ProfileId="@profileId" OnRefresh="RefreshLiveAsync" />

<MudContainer MaxWidth="MaxWidth.False" Class="coach-admin-page">
    <AuthorizeView Roles="Coach"><MudText Typo="Typo.body2">Read-only access: listen to recordings and review transcripts.</MudText></AuthorizeView>
    <AuthorizeView Roles="Owner">
    <MudPaper Class="pa-3 mb-3 coach-admin-upload" Elevation="1">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
            <InputFile OnChange="HandleFileSelected" accept=".m4a,audio/mp4" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UploadAsync" Disabled="@(selectedFile is null || isUploading)">
                @(isUploading ? "Uploading..." : "Upload recording")
            </MudButton>
            @if (selectedFile is not null)
            {
                <MudText Typo="Typo.caption">@selectedFile.Name</MudText>
            }
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(uploadStatus))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@uploadStatus</MudAlert>
        }
    </MudPaper>
    </AuthorizeView>

    <MudGrid>
        <MudItem xs="12" md="4" lg="4">
            <UploadQueuePanel Items="items"
                              IsLoading="isLoading"
                              SelectedUploadId="selectedUploadId"
                              OnSelectUpload="SelectUploadAsync"
                              OnRefresh="LoadAsync" />
        </MudItem>
        <MudItem xs="12" md="8" lg="8">
            <UploadDetailPanel SelectedItem="SelectedItem"
                               IsDownloadingTranscript="isDownloadingTranscript"
                               IsApplyingOverride="isApplyingOverride"
                               OnDownloadTranscript="DownloadTranscriptAsync"
                               OnApplyOverride="ApplyOverrideAsync"
                               OnRoleChanged="HandleRoleChanged"
                               GetOverrideSelection="GetOverrideSelectionForSelectedItem" />
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@errorMessage</MudAlert>
    }
</MudContainer>

@using PersonalAgent.Integrations
@inject PersonalAgent.Web.Services.PersonalAgentClient ApiClient
@implements IAsyncDisposable

<section class="settings-editor backup-settings">
    <h2>Database backups</h2>
    <p>Send database backups to your SFTP server. The Railway job checks these settings daily.</p>
    @if (Error is not null) { <p class="settings-editor__error" role="alert">@Error</p> }
    @if (Notice is not null) { <p class="settings-editor__notice" role="status">@Notice</p> }
    @if (Settings is null)
    {
        <p>Loading backup settings…</p>
    }
    else
    {
        <EditForm Model="Settings" OnSubmit="SaveAsync" FormName="database-backups">
            <fieldset disabled="@Busy">
                <div class="settings-editor__group">
                    <h3>SFTP destination</h3>
                    <div class="backup-settings__endpoint">
                        <div class="settings-editor__field">
                            <label for="backup-host">Host</label>
                            <input id="backup-host" type="text" maxlength="255" autocomplete="off" @bind="Settings.Host" placeholder="backup.example.com" />
                        </div>
                        <div class="settings-editor__field">
                            <label for="backup-port">Port</label>
                            <input id="backup-port" type="number" min="1" max="65535" @bind="Settings.Port" />
                        </div>
                    </div>
                    <div class="settings-editor__columns">
                        <div class="settings-editor__field">
                            <label for="backup-username">Username</label>
                            <input id="backup-username" type="text" maxlength="128" autocomplete="username" @bind="Settings.Username" />
                        </div>
                        <div class="settings-editor__field">
                            <label for="backup-password">Password</label>
                            <input id="backup-password" type="password" autocomplete="new-password" maxlength="4096" @bind="Settings.Password" placeholder="@(Settings.HasPassword ? "Leave blank to keep saved password" : "Enter SFTP password")" />
                            <span class="settings-editor__hint">@(Settings.HasPassword ? "A password is saved. Enter a new one only to replace it." : "No password saved yet.")</span>
                        </div>
                    </div>
                    <div class="settings-editor__field">
                        <label for="backup-fingerprint">SSH host key fingerprint</label>
                        <input id="backup-fingerprint" type="text" maxlength="52" spellcheck="false" @bind="Settings.HostKeySha256" placeholder="SHA256:…" />
                        <span class="settings-editor__hint">Paste the server's SHA-256 fingerprint so the job can verify its identity.</span>
                    </div>
                    <div class="settings-editor__field">
                        <label for="backup-directory">Remote directory</label>
                        <input id="backup-directory" type="text" maxlength="512" spellcheck="false" @bind="Settings.Directory" placeholder="/backups" />
                        <span class="settings-editor__hint">Use an existing absolute path on the SFTP server.</span>
                    </div>
                </div>
                <div class="settings-editor__group">
                    <h3>Schedule</h3>
                    <div class="settings-editor__field backup-settings__interval">
                        <label for="backup-interval">Days between backups</label>
                        <input id="backup-interval" type="number" min="1" max="365" @bind="Settings.IntervalDays" />
                    </div>
                    <span class="settings-editor__hint">The job checks daily at 03:00 UTC and uploads when the interval is due.</span>
                    <label class="settings-editor__toggle" for="backup-enabled">
                        <input id="backup-enabled" type="checkbox" @bind="Settings.Enabled" />
                        Enable SFTP backups
                    </label>
                </div>
                <div class="settings-editor__footer">
                    <button type="submit">Save backup settings</button>
                </div>
            </fieldset>
        </EditForm>
    }
</section>

@code {
    private readonly CancellationTokenSource Lifetime = new();
    private BackupForm? Settings;
    private bool Busy;
    private string? Error;
    private string? Notice;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var saved = await ApiClient.GetBackupSettingsAsync(Lifetime.Token);
            Settings = new(saved.Enabled, saved.Host, saved.Port, saved.Username, "", saved.HasPassword,
                saved.HostKeySha256, saved.Directory, saved.IntervalDays);
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (HttpRequestException) { Error = "Backup settings could not be loaded."; }
    }

    private async Task SaveAsync()
    {
        if (Busy || Settings is null) return;
        Busy = true;
        Error = Notice = null;
        try
        {
            await ApiClient.SaveBackupSettingsAsync(new(Settings.Enabled, Settings.Host, Settings.Port, Settings.Username,
                Settings.Password.Length == 0 ? null : Settings.Password, Settings.HostKeySha256, Settings.Directory, Settings.IntervalDays), Lifetime.Token);
            Settings.Password = "";
            await LoadAsync();
            Notice = "Saved. The backup job reads these settings on its next daily run.";
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (HttpRequestException) { Error = "Backup settings were not saved. Check the host, directory, interval, and SSH host key fingerprint."; }
        finally { Busy = false; }
    }

    public async ValueTask DisposeAsync() { await Lifetime.CancelAsync(); Lifetime.Dispose(); }

    private sealed class BackupForm(bool Enabled, string Host, int Port, string Username, string Password,
        bool HasPassword, string HostKeySha256, string Directory, int IntervalDays)
    {
        public bool Enabled { get; set; } = Enabled;
        public string Host { get; set; } = Host;
        public int Port { get; set; } = Port;
        public string Username { get; set; } = Username;
        public string Password { get; set; } = Password;
        public bool HasPassword { get; set; } = HasPassword;
        public string HostKeySha256 { get; set; } = HostKeySha256;
        public string Directory { get; set; } = Directory;
        public int IntervalDays { get; set; } = IntervalDays;
    }
}

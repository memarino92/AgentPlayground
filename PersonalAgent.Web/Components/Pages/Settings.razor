@page "/admin/settings"
@page "/admin/integrations"
@page "/admin/integration-settings"
@attribute [Authorize(Policy = ServiceCollectionAuthenticationExtensions.OwnerPolicy)]
@inject NavigationManager Navigation

<PageTitle>Settings</PageTitle>
<div class="settings-hub">
    <h1>Settings</h1>
    <nav aria-label="Settings sections">
        <a class="@(CurrentSection == "sentry" ? "active" : null)" href="/admin/settings?section=sentry">Sentry</a>
        <a class="@(CurrentSection == "telemetry" ? "active" : null)" href="/admin/settings?section=telemetry">OpenTelemetry</a>
        <a class="@(CurrentSection == "providers" ? "active" : null)" href="/admin/settings?section=providers">AI providers</a>
        <a class="@(CurrentSection == "automation" ? "active" : null)" href="/admin/settings?section=automation">Automation runner</a>
        <a class="@(CurrentSection == "database" ? "active" : null)" href="/admin/settings?section=database">Database settings</a>
        <a class="@(CurrentSection == "integrations" ? "active" : null)" href="/admin/settings?section=integrations">Integrations and coach access</a>
    </nav>
    @switch (CurrentSection)
    {
        case "sentry": <IntegrationSettings /> break;
        case "telemetry": <IntegrationSettings OpenTelemetry="true" /> break;
        case "providers": <ProviderSettings /> break;
        case "automation": <AutomationRuntimeSettingsPage /> break;
        case "integrations": <IntegrationsAdmin /> break;
        default: <DatabaseSettings /> break;
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }
    private string CurrentSection => Section ?? (Navigation.Uri.Contains("/admin/integrations") ? "integrations" : "database");
}

@implements IAsyncDisposable

<aside class="@(Inline ? "evidence-inline" : "evidence-drawer")" aria-label="Call evidence" @ref="Root" @onkeydown="HandleKeyDown">
    @if (!Inline)
    {
        <header><h2 tabindex="-1">Call evidence</h2><button type="button" @onclick="OnClose">Close evidence</button></header>
    }
    @if (Loading)
    {
        <p role="status">Loading evidence…</p>
    }
    else if (Error is not null)
    {
        <p role="alert">@Error</p>
    }
    else if (Evidence is null)
    {
        <p>The source is unavailable.</p>
    }
    else
    {
        @if (Evidence.AudioAvailable)
        {
            <audio controls preload="metadata" aria-label="Original call recording" src="@AudioUrl"></audio>
            <p data-player-status role="status">Loading recording…</p>
            <div class="player-actions">
                <label><input type="checkbox" data-follow checked /> Follow transcript</label>
                <button type="button" data-skip="-15">Back 15 seconds</button>
                <button type="button" data-skip="15">Forward 15 seconds</button>
                <label>Playback speed <select data-speed><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option></select></label>
            </div>
            @if (IsOwner && Evidence.Transcript.Status is "Completed" or "Failed")
            {
                @if (ConfirmDelete)
                {
                    <p>Delete this recording? The transcript stays readable. Older backups may still contain audio.</p>
                    <button type="button" disabled="@Deleting" @onclick="DeleteAsync">Delete recording</button>
                    <button type="button" disabled="@Deleting" @onclick="() => ConfirmDelete = false">Keep recording</button>
                }
                else
                {
                    <button type="button" @onclick="() => ConfirmDelete = true">Remove audio…</button>
                }
            }
        }
        else
        {
            <p role="status">Audio unavailable. This recording was deleted or was not retained.</p>
        }
        @if (!Inline && (StartMs is null || StartMs < 0))
        {
            <p>No source timestamp is available. Playback starts at the beginning.</p>
        }
        @if (Inline && Evidence.Transcript.Status == "Completed")
        {
            <AuthorizeView Roles="Owner">
                <TranscriptAudioUpload UploadId="UploadId" ProfileId="@ProfileId" HasAudio="Evidence.AudioAvailable"
                    MaxUploadBytes="Evidence.MaxAudioUploadBytes" OnUploaded="ReloadAudioAsync" />
            </AuthorizeView>
        }
        <TranscriptTimeline Transcript="Evidence.Transcript" AudioAvailable="Evidence.AudioAvailable" StartMs="StartMs" />
    }
</aside>

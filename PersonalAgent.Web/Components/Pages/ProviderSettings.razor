@using System.ComponentModel.DataAnnotations

<div class="provider-settings">
    <header class="provider-settings__header">
        <div>
            <p class="eyebrow">Model access</p>
            <h2>AI providers</h2>
            <p>Connect model providers without exposing stored credentials to the browser.</p>
        </div>
        <span class="security-note">Encrypted at rest</span>
    </header>
    @if (Error is not null)
    {
        <div role="alert" class="message message--error"><strong>@ErrorTitle</strong><span>@Error</span></div>
    }
    @if (Notice is not null)
    {
        <div role="status" class="message message--success"><strong>Saved</strong><span>@Notice</span></div>
    }
    @if (!Loaded)
    {
        <section class="loading-card">
            <p>@(Busy ? "Loading provider settings…" : "Provider settings could not be loaded.")</p>
            <button class="button button--secondary" disabled="@Busy" @onclick="RefreshAsync">Retry</button>
        </section>
    }
    else
    {
        <section class="settings-card">
            <div class="settings-card__heading">
                <div class="provider-mark" aria-hidden="true">OR</div>
                <div>
                    <h3>OpenRouter</h3>
                    <p>Access reviewed OpenRouter models and the optional Auto Router through the existing model catalog.</p>
                </div>
                <span class="status-badge @StatusClass"><span></span>@StatusLabel</span>
            </div>
            <EditForm Model="Model" OnValidSubmit="SaveOpenRouterAsync" FormName="openrouter-settings">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />
                <fieldset disabled="@Busy">
                    <div class="field">
                        <div class="field__label">
                            <label for="openrouter-api-key">@(OpenRouterSetting is null ? "API key" : "Replacement API key")</label>
                            <span>Required</span>
                        </div>
                        <InputText id="openrouter-api-key" type="password" autocomplete="new-password" maxlength="4096"
                            placeholder="sk-or-v1-…" spellcheck="false" @bind-Value="Model.ApiKey" />
                        <small>Paste the key from your OpenRouter account. The saved value is never displayed again.</small>
                    </div>
                    <ValidationMessage For="() => Model.ApiKey" />
                    <div class="lifecycle-note"><strong>What happens next</strong><span>The API reloads the credential immediately. OpenRouter Auto becomes the default for new chats when provider discovery reports it available; existing chats keep their saved model. OpenAI remains separate for embeddings and direct capabilities.</span></div>
                    <div class="actions">
                        <button class="button button--primary" type="submit">@(Busy ? "Saving securely…" : OpenRouterSetting is null ? "Connect OpenRouter" : "Replace API key")</button>
                        <button class="button button--secondary" type="button" disabled="@Busy" @onclick="RefreshAsync">Discard changes</button>
                    </div>
                </fieldset>
            </EditForm>
            @if (OpenRouterSetting is not null)
            {
                <p class="settings-card__footer">Need to stop using this credential? <a href="/admin/settings?section=database">Deactivate it in Database settings</a>.</p>
            }
        </section>
    }
</div>

@code {
    private string StatusLabel => OpenRouterSetting is null ? "Not connected" : OpenRouterSetting.IsActive ? "Connected" : "Inactive";
    private string StatusClass => OpenRouterSetting is null ? "status-badge--missing" : OpenRouterSetting.IsActive ? "status-badge--active" : "status-badge--inactive";

    private sealed class OpenRouterFormModel
    {
        [Required(ErrorMessage = "Enter an OpenRouter API key.")]
        [StringLength(4096, MinimumLength = 1)]
        [RegularExpression(@"^[!-~]+$", ErrorMessage = "Use printable characters without spaces.")]
        public string ApiKey { get; set; } = "";
    }
}

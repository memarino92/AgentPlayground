@using System.Security.Claims
@inject PersonalAgentClient ApiClient
@inject ILogger<CoachCheckins> Logger

<PageTitle>PersonalAgent - Coach Check-ins</PageTitle>
@if (trackedUploadId is Guid uploadId && !string.IsNullOrWhiteSpace(profileId))
{
    <CoachCallLiveRefresh @key="uploadId" ProfileId="@profileId" UploadId="uploadId" OnRefresh="RefreshStatusAsync" />
}

<MudContainer MaxWidth="MaxWidth.Large" Class="coach-upload-page">
    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h5">Coach Check-ins</MudText>
            <MudText Typo="Typo.body2">Upload a call recording and track processing until summary generation completes.</MudText>

            <div class="coach-upload-page__picker">
                <InputFile OnChange="HandleFileSelected" accept=".m4a,audio/mp4" disabled="@isUploading" />
            </div>

            @if (selectedFile is not null)
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@selectedFileName (@FormatKb(selectedFile.Size) KB)</MudChip>
            }

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="UploadAsync"
                           Disabled="@(selectedFile is null || IsUploadLocked)">
                    @GetUploadButtonText()
                </MudButton>

                @if (isUploading || isProcessing)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                }
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <MudAlert Severity="@GetStatusSeverity()" Dense="true">@statusMessage</MudAlert>
            }

            @if (latestStatus is not null)
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">Current Upload Status</MudText>
                        <MudText Typo="Typo.body2">Upload: @latestStatus.UploadId</MudText>
                        <MudText Typo="Typo.body2">Status: @latestStatus.Status</MudText>
                        @if (!string.IsNullOrWhiteSpace(latestStatus.Error))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@latestStatus.Error</MudAlert>
                        }
                    </MudStack>
                </MudPaper>
            }

            @if (!string.IsNullOrWhiteSpace(summaryMarkdown))
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.subtitle1">Summary</MudText>
                    <pre class="coach-upload-page__summary">@summaryMarkdown</pre>
                </MudPaper>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string? profileId;
    private IBrowserFile? selectedFile;
    private string selectedFileName = "call.m4a";
    private string selectedContentType = "audio/m4a";
    private bool isUploading;
    private bool isProcessing;
    private Guid? trackedUploadId;
    private readonly SemaphoreSlim refreshGate = new(1, 1);
    private bool hasUploadSubmitted;
    private string? statusMessage;
    private CoachCheckinStatusResponse? latestStatus;
    private string? summaryMarkdown;

    private bool IsUploadLocked => isUploading || isProcessing;

    protected override async Task OnInitializedAsync() => profileId = await ResolveProfileIdAsync();

    private async Task HandleFileSelected(InputFileChangeEventArgs args)
    {
        if (args.FileCount == 0) return;
        selectedFile = args.File;
        selectedFileName = selectedFile.Name;
        selectedContentType = string.IsNullOrWhiteSpace(selectedFile.ContentType) ? "audio/m4a" : selectedFile.ContentType;
        hasUploadSubmitted = false;
        latestStatus = null;
        trackedUploadId = null;
        isProcessing = false;
        summaryMarkdown = null;
        statusMessage = $"Selected {selectedFile.Name} ({FormatKb(selectedFile.Size)} KB)";
    }

    private async Task UploadAsync()
    {
        if (selectedFile is null || string.IsNullOrWhiteSpace(profileId)) return;

        isUploading = true;
        hasUploadSubmitted = true;
        statusMessage = null;
        summaryMarkdown = null;
        Logger.LogInformation("Starting coach check-in upload for profile {ProfileId}", profileId);

        try
        {
            await using var stream = selectedFile.OpenReadStream(Math.Max(selectedFile.Size, 1));
            await using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var upload = await ApiClient.UploadCoachCheckinAsync(profileId, selectedFileName, selectedContentType, memory.ToArray());
            if (upload is null)
            {
                statusMessage = "Upload failed.";
                return;
            }

            statusMessage = upload.IsDuplicate
                ? $"Duplicate detected. Reusing upload {upload.UploadId}."
                : $"Uploaded {upload.UploadId}. Waiting for processing...";
            Logger.LogInformation("Coach check-in upload response {UploadId}, duplicate={IsDuplicate}", upload.UploadId, upload.IsDuplicate);
            trackedUploadId = upload.UploadId;
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Coach check-in upload failed");
            statusMessage = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task RefreshStatusAsync()
    {
        await refreshGate.WaitAsync();
        try { await LoadStatusAsync(); }
        finally { refreshGate.Release(); }
    }

    private async Task LoadStatusAsync()
    {
        if (trackedUploadId is not Guid uploadId || string.IsNullOrWhiteSpace(profileId)) return;
        var status = await ApiClient.GetCoachCheckinStatusAsync(uploadId, profileId);
        if (trackedUploadId != uploadId) return;
        latestStatus = status;
        if (status is null)
        {
            statusMessage = "Upload status unavailable. Retrying automatically...";
            return;
        }

        statusMessage = $"Current status: {status.Status}";
        isProcessing = status.Status is "Uploaded" or "Queued" or "Transcribing" or "Processing";
        hasUploadSubmitted = false;
        if (status.Status == "AwaitingSpeakerOverride")
            statusMessage = "Speaker override is required before processing can continue.";
        if (status.Status == "Completed")
        {
            var summary = await ApiClient.GetCoachCheckinSummaryAsync(uploadId, profileId);
            if (trackedUploadId == uploadId) summaryMarkdown = summary?.SummaryMarkdown;
        }
    }

    private async Task<string?> ResolveProfileIdAsync()
    {
        var authState = await AuthenticationState;
        return authState.User.FindFirst("urn:github:login")?.Value
            ?? authState.User.FindFirst(ClaimTypes.Name)?.Value;
    }

    private string GetUploadButtonText()
    {
        if (isProcessing) return "Processing...";
        if (isUploading) return "Uploading...";
        if (hasUploadSubmitted) return "Working...";
        return "Upload call";
    }

    private Severity GetStatusSeverity()
    {
        if (latestStatus?.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase) is true) return Severity.Error;
        if (latestStatus?.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) is true) return Severity.Success;
        if (latestStatus?.Status.Equals("AwaitingSpeakerOverride", StringComparison.OrdinalIgnoreCase) is true) return Severity.Warning;
        return Severity.Info;
    }

    private static long FormatKb(long sizeBytes) => sizeBytes / 1024;
}

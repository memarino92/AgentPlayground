@page "/coach-checkins"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.Security.Claims
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PersonalAgentClient ApiClient
@inject ILogger<CoachCheckins> Logger

<PageTitle>PersonalAgent - Coach Check-ins</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="coach-upload-page">
    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h5">Coach Check-ins</MudText>
            <MudText Typo="Typo.body2">Upload a call recording and track processing until summary generation completes.</MudText>

            <div class="coach-upload-page__picker">
                <InputFile OnChange="HandleFileSelected" accept=".m4a,audio/mp4" />
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedFileName) && selectedBytes is not null)
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@selectedFileName (@FormatKb(selectedBytes.Length) KB)</MudChip>
            }

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="UploadAsync"
                           Disabled="@(selectedBytes is null || IsUploadLocked)">
                    @GetUploadButtonText()
                </MudButton>

                @if (isUploading || isPolling)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                }
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <MudAlert Severity="@GetStatusSeverity()" Dense="true">@statusMessage</MudAlert>
            }

            @if (latestStatus is not null)
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">Current Upload Status</MudText>
                        <MudText Typo="Typo.body2">Upload: @latestStatus.UploadId</MudText>
                        <MudText Typo="Typo.body2">Status: @latestStatus.Status</MudText>
                        @if (!string.IsNullOrWhiteSpace(latestStatus.Error))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@latestStatus.Error</MudAlert>
                        }
                    </MudStack>
                </MudPaper>
            }

            @if (!string.IsNullOrWhiteSpace(summaryMarkdown))
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.subtitle1">Summary</MudText>
                    <pre class="coach-upload-page__summary">@summaryMarkdown</pre>
                </MudPaper>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string? profileId;
    private byte[]? selectedBytes;
    private string selectedFileName = "call.m4a";
    private string selectedContentType = "audio/m4a";
    private bool isUploading;
    private bool isPolling;
    private bool hasUploadSubmitted;
    private string? statusMessage;
    private CoachCheckinStatusResponse? latestStatus;
    private string? summaryMarkdown;

private bool IsUploadLocked => isUploading || isPolling;

    protected override async Task OnInitializedAsync() => profileId = await ResolveProfileIdAsync();

    private async Task HandleFileSelected(InputFileChangeEventArgs args)
    {
        if (args.FileCount == 0) return;
        var file = args.File;
        selectedFileName = file.Name;
        selectedContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "audio/m4a" : file.ContentType;
        await using var stream = file.OpenReadStream(25 * 1024 * 1024);
        await using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        selectedBytes = memory.ToArray();
        hasUploadSubmitted = false;
        latestStatus = null;
        summaryMarkdown = null;
        statusMessage = $"Selected {file.Name} ({selectedBytes.Length / 1024} KB)";
    }

    private async Task UploadAsync()
    {
        if (selectedBytes is null || string.IsNullOrWhiteSpace(profileId)) return;

        isUploading = true;
        hasUploadSubmitted = true;
        statusMessage = null;
        summaryMarkdown = null;
        Logger.LogInformation("Starting coach check-in upload for profile {ProfileId}", profileId);

        try
        {
            var upload = await ApiClient.UploadCoachCheckinAsync(profileId, selectedFileName, selectedContentType, selectedBytes);
            if (upload is null)
            {
                statusMessage = "Upload failed.";
                return;
            }

            statusMessage = upload.IsDuplicate
                ? $"Duplicate detected. Reusing upload {upload.UploadId}."
                : $"Uploaded {upload.UploadId}. Waiting for processing...";
            Logger.LogInformation("Coach check-in upload response {UploadId}, duplicate={IsDuplicate}", upload.UploadId, upload.IsDuplicate);
            await PollStatusAsync(upload.UploadId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Coach check-in upload failed");
            statusMessage = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task PollStatusAsync(Guid uploadId)
    {
        if (string.IsNullOrWhiteSpace(profileId)) return;

        isPolling = true;

        for (var i = 0; i < 120; i++)
        {
            latestStatus = await ApiClient.GetCoachCheckinStatusAsync(uploadId, profileId);
            if (latestStatus is null)
            {
                statusMessage = "Upload status unavailable.";
                isPolling = false;
                return;
            }

            statusMessage = $"Current status: {latestStatus.Status}";
            Logger.LogInformation("Coach check-in {UploadId} status {Status}", uploadId, latestStatus.Status);
            if (latestStatus.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
            {
                var summary = await ApiClient.GetCoachCheckinSummaryAsync(uploadId, profileId);
                summaryMarkdown = summary?.SummaryMarkdown;
                hasUploadSubmitted = false;
                isPolling = false;
                return;
            }

            if (latestStatus.Status.Equals("AwaitingSpeakerOverride", StringComparison.OrdinalIgnoreCase))
            {
                statusMessage = "Speaker override is required before processing can continue.";
                hasUploadSubmitted = false;
                isPolling = false;
                return;
            }

            if (latestStatus.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase))
            {
                hasUploadSubmitted = false;
                isPolling = false;
                return;
            }
            await Task.Delay(TimeSpan.FromSeconds(4));
        }

        statusMessage = "Processing is still running. Refresh in a few minutes.";
        hasUploadSubmitted = false;
        isPolling = false;
    }

    private async Task<string?> ResolveProfileIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirst("urn:github:login")?.Value
            ?? authState.User.FindFirst(ClaimTypes.Name)?.Value;
    }

    private string GetUploadButtonText()
    {
        if (isPolling) return "Processing...";
        if (isUploading) return "Uploading...";
        if (hasUploadSubmitted) return "Working...";
        return "Upload call";
    }

    private Severity GetStatusSeverity()
    {
        if (latestStatus?.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase) is true) return Severity.Error;
        if (latestStatus?.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) is true) return Severity.Success;
        if (latestStatus?.Status.Equals("AwaitingSpeakerOverride", StringComparison.OrdinalIgnoreCase) is true) return Severity.Warning;
        return Severity.Info;
    }

    private static int FormatKb(int sizeBytes) => sizeBytes / 1024;
}

@page "/chat"
@attribute [Authorize(Policy = ServiceCollectionAuthenticationExtensions.CoachTranscriptPolicy)]
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.WebUtilities
@using System.Security.Claims
@implements IDisposable
@inject ProtectedLocalStorage ModelStorage
@inject PersonalAgentClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<PageTitle>PersonalAgent - Chat</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="chat-page">
    <div class="chat-shell @(isSessionDrawerOpen ? "chat-shell--drawer-open" : "chat-shell--drawer-closed")">
        @if (isSessionDrawerOpen)
        {
            <ChatSessionPanel Sessions="sessions"
                              IsLoadingSessions="isLoadingSessions"
                              IsBusy="isBusy"
                              HasMoreSessions="hasMoreSessions"
                              SelectedSessionOption="@GetSelectedSessionOption()"
                              OnSessionSelectionChanged="HandleSessionSelectionChanged"
                              OnLoadMoreSessions="LoadMoreSessionsAsync"
                              OnCloseDrawer="CloseSessionDrawer" />
        }

        <MudPaper Class="chat-panel" Elevation="1">
            <MudStack Spacing="2" Class="chat-panel__header">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">Agent chat</MudText>
                    <MudStack Row="true" Spacing="1" Class="chat-panel__actions">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ToggleSessionDrawer">@(isSessionDrawerOpen ? "Hide chats" : "Show chats")</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSession" Disabled="@(isBusy || string.IsNullOrWhiteSpace(selectedModelId))">New chat</MudButton>
                    </MudStack>
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@errorMessage</MudAlert>
                }

            </MudStack>

            @if (hasAttemptedRestore)
            {
                <ChatMessageList Messages="messages" IsSendingMessage="isSendingMessage" ContainerId="@MessageListContainerId" ProfileId="@profileId" />

                @if (isReadOnly)
                {
                    <MudText Typo="Typo.body2">This conversation is the saved record of a scheduled job. Start a new chat for follow-up work.</MudText>
                }
                else
                {
                <ChatComposer CurrentMessage="@currentMessage"
                              CurrentMessageChanged="HandleCurrentMessageChanged"
                              SelectedModelId="@(selectedModelId ?? string.Empty)"
                              SelectedModelIdChanged="HandleSelectedModelChanged"
                              Models="availableModels"
                              IsBusy="isBusy"
                              OnKeyDown="HandleKeyDown"
                              OnSendMessage="SendMessage" />
                }

                <div class="chat-panel__footer">
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">Chat: @(sessionId ?? "New chat")</MudChip>
                    @if (!string.IsNullOrWhiteSpace(activeModelDisplayName))
                    {
                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">Model: @activeModelDisplayName</MudChip>
                    }
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ResetSelectionAsync" Disabled="@isBusy">Clear</MudButton>
                </div>
            }
        </MudPaper>
    </div>
</MudContainer>

@page "/chat"
@attribute [Authorize(Policy = ServiceCollectionAuthenticationExtensions.CoachTranscriptPolicy)]
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.WebUtilities
@using System.Security.Claims
@implements IDisposable
@inject ProtectedLocalStorage ModelStorage
@inject PersonalAgentClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<PageTitle>Garden - Conversation</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="chat-page">
    <div class="chat-shell @(isSessionDrawerOpen ? "chat-shell--drawer-open" : "chat-shell--drawer-closed")">
        @if (isSessionDrawerOpen)
        {
            <ChatSessionPanel Sessions="sessions"
                              IsLoadingSessions="isLoadingSessions"
                              IsBusy="isBusy"
                              HasMoreSessions="hasMoreSessions"
                              SelectedSessionOption="@GetSelectedSessionOption()"
                              OnSessionSelectionChanged="HandleSessionSelectionChanged"
                              OnLoadMoreSessions="LoadMoreSessionsAsync"
                              OnCloseDrawer="CloseSessionDrawer">
                <ChatHistorySearch ProfileId="@profileId" Busy="@(isBusy || isSearchingHistory)" Results="historyResults" OnSearch="SearchHistoryAsync" />
            </ChatSessionPanel>
        }

        <MudPaper Class="chat-panel" Elevation="1">
            <MudStack Spacing="2" Class="chat-panel__header">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <div><span class="chat-eyebrow">Your digital garden</span><MudText Typo="Typo.h6">What's on your mind?</MudText></div>
                    <MudStack Row="true" Spacing="1" Class="chat-panel__actions">
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ToggleSessionDrawer">@(isSessionDrawerOpen ? "Hide history" : "History")</MudButton>
                        @if (isContinuous)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CreateSession" Disabled="@isBusy">Start fresh</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="ReturnToConversationAsync" Disabled="@isBusy">Back to conversation</MudButton>
                        }
                    </MudStack>
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@errorMessage</MudAlert>
                }
                @if (notice is not null) { <p class="chat-notice" role="status">@notice</p> }

            </MudStack>

            @if (hasAttemptedRestore)
            {
                @if (isLoadingHistory || !hasInitialized) { <MudProgressLinear Indeterminate="true" /> }
                @if (hasInitialized && messages.Count == 0 && !isLoadingHistory)
                {
                    <div class="chat-empty"><h2>A little space to think out loud.</h2><p>Pick up an idea, make a plan, or just start talking. I'll bring in relevant earlier context when I find it.</p></div>
                }
                <ChatMessageList Messages="messages" IsSendingMessage="isSendingMessage" ContainerId="@MessageListContainerId" ProfileId="@profileId"
                                 IsReadOnly="isReadOnly" IsUpdatingCard="isUpdatingCard" OnCardAction="HandleCardActionAsync" HighlightSequence="RequestedMessage" />

                @if (isReadOnly)
                {
                    <MudText Typo="Typo.body2">You're viewing saved history. Return to your conversation to continue.</MudText>
                }
                else
                {
                <ChatComposer CurrentMessage="@currentMessage"
                              CurrentMessageChanged="HandleCurrentMessageChanged"
                              SelectedModelId="@(selectedModelId ?? string.Empty)"
                              SelectedModelIdChanged="HandleSelectedModelChanged"
                              Models="availableModels"
                              IsBusy="isBusy"
                              OnKeyDown="HandleKeyDown"
                              OnSendMessage="SendMessage" />
                }

                <div class="chat-panel__footer">
                    <span>@(isContinuous ? "One conversation. Your history stays yours." : "Saved history")</span>
                </div>
            }
        </MudPaper>
    </div>
</MudContainer>

@page "/"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.WebUtilities
@using System.Security.Claims
@implements IDisposable
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ProtectedSessionStorage SessionStorage
@inject PersonalAgentClient ApiClient
@inject TestEventPublisher TestEventPublisher
@inject NavigationManager NavigationManager

<PageTitle>PersonalAgent - Chat</PageTitle>

<div class="chat-page">
    <div class="chat-shell">
        @if (isSessionDrawerOpen)
        {
            <ChatSessionPanel Sessions="sessions"
                              IsLoadingSessions="isLoadingSessions"
                              IsBusy="isBusy"
                              HasMoreSessions="hasMoreSessions"
                              SelectedSessionOption="@GetSelectedSessionOption()"
                              FormatSessionOption="FormatSessionOption"
                              OnSessionSelectionChanged="HandleSessionSelectionChanged"
                              OnLoadMoreSessions="LoadMoreSessionsAsync"
                              OnCloseDrawer="CloseSessionDrawer" />
        }

        <section class="chat-panel">
            @if (sessionId is null)
            {
                <div class="chat-panel__empty">
                    <h2>No Session Selected</h2>
                    <p>Select a prior session or start a new chat.</p>
                    <button class="btn btn-primary" @onclick="CreateSession" disabled="@(isBusy || string.IsNullOrWhiteSpace(selectedModelId))">New chat</button>
                </div>
            }
            else
            {
                <ChatMessageList Messages="messages" IsSendingMessage="isSendingMessage" />

                <ChatComposer CurrentMessage="@currentMessage"
                              CurrentMessageChanged="HandleCurrentMessageChanged"
                              SelectedModelId="@(selectedModelId ?? string.Empty)"
                              SelectedModelIdChanged="HandleSelectedModelChanged"
                              Models="availableModels"
                              IsBusy="isBusy"
                              OnKeyDown="HandleKeyDown"
                              OnSendMessage="SendMessage" />

                <div class="chat-panel__footer">
                    <span class="chat-panel__session-id">@sessionId</span>
                    @if (!string.IsNullOrWhiteSpace(activeModelDisplayName))
                    {
                        <span class="chat-panel__session-id">Model: @activeModelDisplayName</span>
                    }
                    <button class="btn btn-secondary" @onclick="ResetSelectionAsync" disabled="@isBusy">Clear</button>
                    <button class="btn btn-secondary" @onclick="PublishTestEvent" disabled="@isPublishingTestEvent">Test event</button>
                    <button class="btn btn-primary" @onclick="CreateSession" disabled="@(isBusy || string.IsNullOrWhiteSpace(selectedModelId))">New chat</button>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private const string SessionStorageKey = "personal-agent-session-id";
    private const string ProfileStorageKey = "personal-agent-profile-id";
    private const int SessionPageSize = 20;
    private string? sessionId;
    private string? profileId;
    private string? selectedModelId;
    private string? activeModelId;
    private List<SessionListItem> sessions = new();
    private List<ConversationMessage> messages = new();
    private List<AvailableChatModelResponse> availableModels = new();
    private string currentMessage = string.Empty;
    private bool isLoadingHistory;
    private bool isSendingMessage;
    private bool isCreatingSession;
    private bool isLoadingSessions;
    private bool isPublishingTestEvent;
    private string? testEventStatus;
    private string? errorMessage;
    private bool hasAttemptedRestore;
    private bool hasHandledQueryActions;
    private bool isSessionDrawerOpen;
    private DateTimeOffset? nextBeforeActivityAt;
    private Guid? nextBeforeSessionId;
    private bool hasMoreSessions;

    private bool isBusy => isLoadingHistory || isSendingMessage || isCreatingSession;
    private string? activeModelDisplayName => availableModels.FirstOrDefault(model => model.Id == activeModelId)?.DisplayName ?? activeModelId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasAttemptedRestore) return;

        hasAttemptedRestore = true;
        NavigationManager.LocationChanged += HandleLocationChanged;
        await InitializeAsync();
        StateHasChanged();
    }

    private async Task InitializeAsync()
    {
        try
        {
            await HandleQueryActionsAsync();
            var resolvedProfileId = await ResolveProfileIdAsync();
            if (string.IsNullOrWhiteSpace(resolvedProfileId))
            {
                await ClearStoredProfileIdAsync();
                await ClearStoredSessionIdAsync();
                return;
            }

            profileId = resolvedProfileId;
            await LoadModelsAsync();
            await LoadSessionsAsync();
            await RestoreSessionAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task PublishTestEvent()
    {
        isPublishingTestEvent = true;
        testEventStatus = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var requestedBy = authState.User.FindFirst("urn:github:login")?.Value
                ?? authState.User.FindFirst(ClaimTypes.Name)?.Value
                ?? "anonymous";

            var correlationId = await TestEventPublisher.PublishAsync(requestedBy);
            testEventStatus = $"Published test event {correlationId}";
        }
        finally
        {
            isPublishingTestEvent = false;
        }
    }

    private async Task HandleQueryActionsAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("drawer", out var drawerValue) && drawerValue.Count > 0 && drawerValue[0] == "1")
            isSessionDrawerOpen = true;

        if (query.TryGetValue("testEvent", out var value) && value.Count > 0 && value[0] == "1")
        {
            if (hasHandledQueryActions) return;

            hasHandledQueryActions = true;
            await PublishTestEvent();
        }
    }

    private async Task CreateSession()
    {
        isCreatingSession = true;
        errorMessage = null;
        try
        {
            var resolvedProfileId = await ResolveProfileIdAsync();
            if (string.IsNullOrWhiteSpace(resolvedProfileId))
            {
                errorMessage = "Unable to determine your GitHub profile id for chat memory.";
                return;
            }

            profileId = resolvedProfileId;

            var response = await ApiClient.CreateSessionAsync(resolvedProfileId, selectedModelId);
            if (response != null)
            {
                activeModelId = response.ModelId;
                selectedModelId = response.ModelId;
                await SelectSessionAsync(response.SessionId, []);
                isSessionDrawerOpen = false;
                await SetStoredProfileIdAsync(resolvedProfileId);
                await LoadSessionsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isCreatingSession = false;
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || sessionId == null || profileId == null) return;

        errorMessage = null;
        var userMessage = currentMessage;
        currentMessage = string.Empty;
        
        messages.Add(new ConversationMessage("user", userMessage));
        
        isSendingMessage = true;
        try
        {
            var response = await ApiClient.SendMessageAsync(sessionId, profileId, userMessage, selectedModelId);
            if (response != null)
            {
                activeModelId = response.ModelId;
                selectedModelId = response.ModelId;
                messages.Add(new ConversationMessage("assistant", response.Response));
                UpdateSessionSummary(sessionId, userMessage, DateTimeOffset.UtcNow);
            }
        }
        catch (Exception ex)
        {
            messages.RemoveAt(messages.Count - 1);
            currentMessage = userMessage;
            errorMessage = ex.Message;
        }
        finally
        {
            isSendingMessage = false;
        }
    }

    private async Task ResetSelectionAsync()
    {
        sessionId = null;
        activeModelId = null;
        messages.Clear();
        currentMessage = string.Empty;
        errorMessage = null;
        await ClearStoredSessionIdAsync();
    }

    private async Task SelectSessionAsync(string selectedSessionId, List<ConversationMessage>? knownMessages = null)
    {
        if (profileId is null) return;

        sessionId = selectedSessionId;
        isSessionDrawerOpen = false;
        currentMessage = string.Empty;
        errorMessage = null;
        await SetStoredSessionIdAsync(selectedSessionId);

        if (knownMessages is not null)
        {
            messages = [.. knownMessages];
            return;
        }

        await LoadSelectedSessionHistoryAsync(selectedSessionId);
    }

    private async Task HandleSessionSelectionChanged(string? selectedSessionId)
    {
        if (string.IsNullOrWhiteSpace(selectedSessionId))
        {
            await ResetSelectionAsync();
            return;
        }

        if (selectedSessionId == sessionId) return;
        await SelectSessionAsync(selectedSessionId);
    }

    private async Task LoadSelectedSessionHistoryAsync(string selectedSessionId)
    {
        if (profileId is null) return;

        isLoadingHistory = true;
        try
        {
            var history = await ApiClient.GetHistoryAsync(selectedSessionId, profileId);
            if (history is null)
            {
                if (sessionId == selectedSessionId)
                    await ResetSelectionAsync();

                sessions.RemoveAll(session => session.SessionId == selectedSessionId);
                return;
            }

            sessionId = history.SessionId;
            activeModelId = history.ModelId;
            selectedModelId = history.ModelId;
            messages = [.. history.Messages];
        }
        catch (PersonalAgentApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            if (sessionId == selectedSessionId)
                await ResetSelectionAsync();

            sessions.RemoveAll(session => session.SessionId == selectedSessionId);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isBusy && !string.IsNullOrWhiteSpace(currentMessage))
        {
            await SendMessage();
        }
    }

    private Task HandleCurrentMessageChanged(string value)
    {
        currentMessage = value;
        return Task.CompletedTask;
    }

    private Task HandleSelectedModelChanged(string value)
    {
        selectedModelId = value;
        return Task.CompletedTask;
    }

    private void CloseSessionDrawer() => isSessionDrawerOpen = false;

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        hasHandledQueryActions = false;
        await InvokeAsync(async () =>
        {
            await HandleQueryActionsAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => NavigationManager.LocationChanged -= HandleLocationChanged;

    private async Task RestoreSessionAsync()
    {
        if (profileId is null) return;

        try
        {
            var storedProfile = await SessionStorage.GetAsync<string>(ProfileStorageKey);
            var storedSession = await SessionStorage.GetAsync<string>(SessionStorageKey);
            if (!storedSession.Success || string.IsNullOrWhiteSpace(storedSession.Value)) return;

            if (storedProfile.Success && !string.IsNullOrWhiteSpace(storedProfile.Value) && !string.Equals(storedProfile.Value, profileId, StringComparison.OrdinalIgnoreCase))
            {
                await ClearStoredProfileIdAsync();
                await ClearStoredSessionIdAsync();
                return;
            }

            await SetStoredProfileIdAsync(profileId);
            await SelectSessionAsync(storedSession.Value);
        }
        catch (PersonalAgentApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            await ClearStoredProfileIdAsync();
            await ClearStoredSessionIdAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadSessionsAsync(bool append = false)
    {
        if (profileId is null) return;

        isLoadingSessions = true;
        errorMessage = null;

        try
        {
            var page = await ApiClient.GetSessionsAsync(profileId, append ? nextBeforeActivityAt : null, append ? nextBeforeSessionId : null, SessionPageSize);
            if (page is null) return;

            if (!append)
                sessions.Clear();

            sessions = append
                ? [.. sessions, .. page.Sessions.Where(candidate => sessions.All(existing => existing.SessionId != candidate.SessionId))]
                : [.. page.Sessions];

            hasMoreSessions = page.HasMore;
            nextBeforeActivityAt = page.NextBeforeActivityAt;
            nextBeforeSessionId = page.NextBeforeSessionId;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoadingSessions = false;
        }
    }

    private async Task LoadModelsAsync()
    {
        var response = await ApiClient.GetModelsAsync();
        availableModels = response?.Models ?? [];
        selectedModelId ??= availableModels.FirstOrDefault(model => model.IsDefault)?.Id ?? availableModels.FirstOrDefault()?.Id;
    }

    private async Task LoadMoreSessionsAsync()
    {
        if (!hasMoreSessions) return;
        await LoadSessionsAsync(append: true);
    }

    private void UpdateSessionSummary(string selectedSessionId, string snippet, DateTimeOffset lastActivityAt)
    {
        var trimmedSnippet = CreateSnippet(snippet);
        var existingIndex = sessions.FindIndex(session => session.SessionId == selectedSessionId);
        var createdAt = existingIndex >= 0 ? sessions[existingIndex].CreatedAt : lastActivityAt;
        var updated = new SessionListItem(selectedSessionId, trimmedSnippet, lastActivityAt, createdAt);

        if (existingIndex >= 0)
            sessions.RemoveAt(existingIndex);

        sessions.Insert(0, updated);
    }

    private string GetSelectedSessionOption() => sessionId ?? string.Empty;

    private static string FormatSessionOption(SessionListItem session) => $"{session.Snippet} ({FormatTimestamp(session.LastActivityAt)})";

    private static string CreateSnippet(string message)
    {
        var normalized = message.Trim();
        if (normalized.Length <= 72) return normalized;
        return normalized[..69] + "...";
    }

    private static string FormatTimestamp(DateTimeOffset timestamp) => timestamp.ToLocalTime().ToString("g");

    private async Task SetStoredSessionIdAsync(string value)
    {
        await SessionStorage.SetAsync(SessionStorageKey, value);
    }

    private async Task SetStoredProfileIdAsync(string value)
    {
        await SessionStorage.SetAsync(ProfileStorageKey, value);
    }

    private async Task ClearStoredSessionIdAsync()
    {
        await SessionStorage.DeleteAsync(SessionStorageKey);
    }

    private async Task ClearStoredProfileIdAsync()
    {
        await SessionStorage.DeleteAsync(ProfileStorageKey);
    }

    private async Task<string?> ResolveProfileIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirst("urn:github:login")?.Value;
    }
}

@page "/mobile/connect"
@inject MobileChatGrant Grants
@inject NavigationManager Navigation

<PageTitle>Connect Android</PageTitle>
<section class="connect-panel" aria-labelledby="connect-title">
<span class="connect-robot" aria-hidden="true">🤖</span>
<h1 id="connect-title">Connect your phone</h1>
@if (!MobileChatGrant.IsChallenge(Challenge))
{
    <p>Start sign-in from the Android app.</p>
}
else
{
    <AuthorizeView Roles="Owner,Coach">
        <Authorized>
            <p>Allow PersonalAgent on this phone to access your conversations, recordings, jobs and automations, and manage any settings available to your account for 24 hours?</p>
            <button class="connect-action" type="button" @onclick="() => Connect(context.User)">Connect this phone</button>
        </Authorized>
        <NotAuthorized>
            <a class="connect-provider" href="@LoginUrl("GitHub")">Sign in with GitHub</a>
            <a class="connect-provider" href="@LoginUrl("Google")">Sign in with Google</a>
        </NotAuthorized>
    </AuthorizeView>
}

</section>

@code {
    [SupplyParameterFromQuery] public string? Challenge { get; set; }

    private string LoginUrl(string Provider) =>
        $"/login?provider={Provider}&returnUrl={Uri.EscapeDataString($"/mobile/connect?challenge={Challenge}")}";

    private void Connect(System.Security.Claims.ClaimsPrincipal User)
    {
        var Grant = Grants.Issue(User, Challenge!);
        Navigation.NavigateTo($"personalagentmobile://chat?grant={Uri.EscapeDataString(Grant)}", forceLoad: true);
    }
}

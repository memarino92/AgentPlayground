@page "/access-denied"

<PageTitle>PersonalAgent - Access denied</PageTitle>

<div class="login-prompt">
    <h2>You do not have access to PersonalAgent</h2>
    <p>Log out and sign in with an authorized GitHub or Google account.</p>
    <form method="post" action="/logout">
        <button type="submit" class="btn btn-logout">Log out</button>
    </form>
</div>

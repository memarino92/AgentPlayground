@page "/"
@inject NavigationManager NavigationManager

<PageTitle>PersonalAgent</PageTitle>

<div class="login-prompt">
    <MudProgressCircular Indeterminate="true" />
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private bool hasRedirected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasRedirected) return;

        hasRedirected = true;
        var authState = await AuthenticationState;
        var destination = authState.User.Identity?.IsAuthenticated != true
            ? "/login"
            : authState.User.IsInRole("Owner")
                ? "/chat"
                : authState.User.IsInRole("Coach")
                    ? "/chat"
                    : "/access-denied";

        NavigationManager.NavigateTo(destination, forceLoad: true);
    }
}

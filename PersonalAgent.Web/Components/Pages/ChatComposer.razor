<div class="composer">
    <textarea class="composer__input"
              @bind="Draft"
              @bind:after="HandleInput"
              @bind:event="oninput"
              @onkeydown="OnKeyDown"
              data-send-on-enter="true"
              disabled="@IsBusy"
              rows="2"
              aria-label="Message Garden"
              placeholder="What's on your mind?"></textarea>
    <details class="composer__settings">
    <summary>Model</summary>
    <select class="composer__model"
            value="@SelectedModelId"
            @onchange="HandleModelChanged"
            disabled="@(IsBusy || Models.Count == 0)">
        @foreach (var model in Models)
        {
            <option value="@model.Id">@model.DisplayName</option>
        }
    </select>
    </details>
    @if (IsSending)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="composer__send" OnClick="OnStop">Stop</MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="composer__send" OnClick="OnSendMessage" Disabled="@(IsBusy || Models.Count == 0 || string.IsNullOrWhiteSpace(CurrentMessage))">Send</MudButton>
    }
</div>

@code {
    private string Draft = string.Empty;
    protected override void OnParametersSet() => Draft = CurrentMessage;
    [Parameter] public required string CurrentMessage { get; set; }
    [Parameter] public required string SelectedModelId { get; set; }
    [Parameter] public required List<AvailableChatModelResponse> Models { get; set; }
    [Parameter] public required bool IsBusy { get; set; }
    [Parameter] public bool IsSending { get; set; }
    [Parameter] public required EventCallback<string> CurrentMessageChanged { get; set; }
    [Parameter] public required EventCallback<string> SelectedModelIdChanged { get; set; }
    [Parameter] public required EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public required EventCallback OnSendMessage { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }

    private Task HandleInput() => CurrentMessageChanged.InvokeAsync(Draft);

    private Task HandleModelChanged(ChangeEventArgs e) => SelectedModelIdChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
